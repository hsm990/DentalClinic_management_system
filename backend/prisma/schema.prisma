datasource db {
  provider = "postgresql"
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

enum OrthodonticCaseStatus {
  ACTIVE
  COMPLETED
  DISCONTINUED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum TaskTargetType {
  USER
  ROLE
  CLINIC
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DENTIST
  ASSISTANT
  RECEPTIONIST
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Gender {
  MALE
  FEMALE
}

enum ToothCondition {
  HEALTHY
  DECAYED
  FILLED
  CROWNED
  ROOT_CANAL
  MISSING
  IMPLANT
  FRACTURED
  IMPACTED
}

enum TreatmentPlanItemStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_PAYMENT
  OTHER
}

// ---------- MODELS ----------

model Clinic {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  patients            Patient[]
  procedureCategories ProcedureCategory[]
  procedures          Procedure[]
  appointments        Appointment[]
  invoices            Invoice[]
  tasks               Task[]
  inventoryItems      InventoryItem[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole @default(RECEPTIONIST)
  isActive     Boolean  @default(true)
  clinicId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinic          Clinic?       @relation(fields: [clinicId], references: [id])
  appointments    Appointment[] @relation("DentistAppointments")
  createdInvoices Invoice[]

  treatmentPlansCreated     TreatmentPlan[]     @relation("TreatmentPlanCreatedBy")
  treatmentPlanItemsCreated TreatmentPlanItem[] @relation("TreatmentPlanItemCreatedBy")

  tasksCreated       Task[]             @relation("TaskCreatedBy")
  tasksAssigned      Task[]             @relation("TaskAssignedToUser")
  orthoCasesDentist  OrthodonticCase[]  @relation("OrthoCaseDentist")
  orthoCasesCreated  OrthodonticCase[]  @relation("OrthoCaseCreatedBy")
  orthoVisitsCreated OrthodonticVisit[] @relation("OrthoVisitCreatedBy")
  personalTodos      PersonalTodo[]

  @@index([clinicId])
}

model InventoryItem {
  id                String    @id @default(cuid())
  reference         String
  name              String
  category          String
  quantity          Int       @default(0)
  unitPrice         Decimal   @db.Decimal(10, 2)
  dateAdded         DateTime  @default(now())
  expiryDate        DateTime?
  supplier          String?
  lowStockThreshold Int       @default(5)
  clinicId          String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, reference])
  @@index([clinicId])
}

model Patient {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  phone        String?
  email        String?
  dateOfBirth  DateTime?
  gender       Gender?
  address      String?
  allergies    String?
  medicalNotes String?
  isActive     Boolean   @default(true)
  clinicId     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clinic           Clinic            @relation(fields: [clinicId], references: [id])
  appointments     Appointment[]
  toothChart       ToothChartEntry[]
  treatmentPlans   TreatmentPlan[]
  invoices         Invoice[]
  orthodonticCases OrthodonticCase[]

  @@index([clinicId])
}

model ProcedureCategory {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  clinicId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic     Clinic      @relation(fields: [clinicId], references: [id])
  procedures Procedure[]

  @@index([clinicId])
}

model Procedure {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  durationMin Int      @default(30)
  isActive    Boolean  @default(true)
  categoryId  String
  clinicId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category           ProcedureCategory   @relation(fields: [categoryId], references: [id])
  clinic             Clinic              @relation(fields: [clinicId], references: [id])
  treatmentPlanItems TreatmentPlanItem[]
  invoiceItems       InvoiceItem[]

  @@index([categoryId])
  @@index([clinicId])
}

model Appointment {
  id          String            @id @default(cuid())
  scheduledAt DateTime
  durationMin Int               @default(30)
  status      AppointmentStatus @default(SCHEDULED)
  reason      String?
  notes       String?

  patientId String
  dentistId String
  clinicId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  dentist User    @relation("DentistAppointments", fields: [dentistId], references: [id])
  clinic  Clinic  @relation(fields: [clinicId], references: [id])

  @@index([clinicId, scheduledAt])
  @@index([dentistId])
  @@index([patientId])
}

model ToothChartEntry {
  id          String         @id @default(cuid())
  toothNumber Int // FDI notation, 11–48
  condition   ToothCondition @default(HEALTHY)
  notes       String?
  patientId   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])

  @@unique([patientId, toothNumber])
  @@index([patientId])
}

model TreatmentPlan {
  id          String   @id @default(cuid())
  title       String
  notes       String?
  patientId   String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient   Patient @relation(fields: [patientId], references: [id])
  createdBy User?   @relation("TreatmentPlanCreatedBy", fields: [createdById], references: [id])

  items TreatmentPlanItem[]

  @@index([patientId])
}

model TreatmentPlanItem {
  id              String                  @id @default(cuid())
  toothNumber     Int?
  status          TreatmentPlanItemStatus @default(PLANNED)
  estimatedCost   Decimal                 @db.Decimal(10, 2)
  notes           String?
  createdById     String?
  treatmentPlanId String
  procedureId     String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  invoiceItem     InvoiceItem?
  treatmentPlan   TreatmentPlan           @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  procedure       Procedure               @relation(fields: [procedureId], references: [id])
  createdBy       User?                   @relation("TreatmentPlanItemCreatedBy", fields: [createdById], references: [id])

  @@index([treatmentPlanId])
  @@index([procedureId])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber Int           @default(autoincrement())
  status        InvoiceStatus @default(PENDING)
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  notes         String?

  patientId   String
  clinicId    String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient   Patient       @relation(fields: [patientId], references: [id])
  clinic    Clinic        @relation(fields: [clinicId], references: [id])
  createdBy User?         @relation(fields: [createdById], references: [id])
  items     InvoiceItem[]
  payments  Payment[]

  @@unique([clinicId, invoiceNumber])
  @@index([patientId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  toothNumber Int?
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(10, 2)
  notes       String?

  invoiceId   String
  procedureId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  treatmentPlanItemId String?            @unique // new
  treatmentPlanItem   TreatmentPlanItem? @relation(fields: [treatmentPlanItemId], references: [id]) // new
  invoice             Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  procedure           Procedure          @relation(fields: [procedureId], references: [id])

  @@index([invoiceId])
  @@index([procedureId])
}

model Payment {
  id     String        @id @default(cuid())
  amount Decimal       @db.Decimal(10, 2)
  method PaymentMethod @default(CASH)
  paidAt DateTime      @default(now())
  notes  String?

  invoiceId String
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model Task {
  id           String         @id @default(cuid())
  title        String
  description  String?
  dueDate      DateTime?
  status       TaskStatus     @default(PENDING)
  targetType   TaskTargetType
  targetUserId String?
  targetRole   UserRole?
  clinicId     String
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  clinic     Clinic @relation(fields: [clinicId], references: [id])
  createdBy  User   @relation("TaskCreatedBy", fields: [createdById], references: [id])
  targetUser User?  @relation("TaskAssignedToUser", fields: [targetUserId], references: [id])

  @@index([clinicId])
  @@index([targetUserId])
}

model OrthodonticCase {
  id               String                @id @default(cuid())
  applianceType    String // e.g. "Metal braces", "Clear aligners"
  startDate        DateTime
  estimatedEndDate DateTime?
  status           OrthodonticCaseStatus @default(ACTIVE)
  notes            String?
  patientId        String
  dentistId        String
  createdById      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  patient   Patient            @relation(fields: [patientId], references: [id])
  dentist   User               @relation("OrthoCaseDentist", fields: [dentistId], references: [id])
  createdBy User?              @relation("OrthoCaseCreatedBy", fields: [createdById], references: [id])
  visits    OrthodonticVisit[]

  @@index([patientId])
}

model OrthodonticVisit {
  id            String    @id @default(cuid())
  visitDate     DateTime  @default(now())
  notes         String
  nextVisitDate DateTime?
  caseId        String
  createdById   String?
  createdAt     DateTime  @default(now())

  case      OrthodonticCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("OrthoVisitCreatedBy", fields: [createdById], references: [id])

  @@index([caseId])
}

model PersonalTodo {
  id        String   @id @default(cuid())
  text      String
  date      DateTime // the day this todo is for (time portion ignored)
  isDone    Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, date])
}
